# Hugging Face Access Token with write/admin permissions for configured repositories
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of repositories in the format <repo-type>:<owner>/<repo-name>
# Supported repo types: model, dataset, space (Note: spaces do not currently support gating API)
HF_REPOSITORIES=model:owner/model-a,dataset:owner/dataset-a,dataset:owner/dataset-b

# Shared application password for reviewers (minimum 16 characters)
APP_PASSWORD=change-me-to-a-secure-password-16chars

# Secret key used for signing session JWTs (must be at least 32 characters long)
AUTH_SECRET=please-generate-a-secure-random-secret-key-32chars

# Optional session duration in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE=604800
