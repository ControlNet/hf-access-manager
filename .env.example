# Hugging Face Access Token with write/admin permissions for configured repositories
HF_TOKEN=

# Comma-separated list of repositories in the format <repo-type>:<owner>/<repo-name>
# Supported repo types: model, dataset, space (Note: spaces do not currently support gating API)
HF_REPOSITORIES=

# Shared application password for reviewers (minimum 16 characters)
APP_PASSWORD=

# Optional for a single Node/Docker instance: empty generates a random key in memory.
# Restarting then invalidates sessions. Required on Vercel and multi-instance deployments.
# If explicitly provided, use at least 32 characters; never share or commit the value.
AUTH_SECRET=

# Optional canonical public origin, including scheme and port, without a path.
# Recommended behind reverse proxies. Production should use HTTPS.
APP_ORIGIN=

# Optional session duration in seconds, integer 1..31536000 (default: 7 days)
SESSION_MAX_AGE=604800
